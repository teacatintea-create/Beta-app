{
  "manifest_version": 3,
  "name": "FocusTube — только полезный YouTube",
  "short_name": "FocusTube",
  "version": "1.0.0",
  "description": "Скрывает развлекательные ролики, Shorts и ленту рекомендаций. Оставляет научный, образовательный и творческий контент.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.googleapis.com/youtube/v3/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/defaults.js", "src/background.js"]
  },
  "action": {
    "default_title": "FocusTube",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtube.com/*"],
      "js": [
        "src/defaults.js",
        "src/classifier.js",
        "src/metadata.js",
        "src/platform-extension.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "focustube@example.org",
      "strict_min_version": "121.0"
    },
    "gecko_android": {
      "strict_min_version": "121.0"
    }
  }
}
